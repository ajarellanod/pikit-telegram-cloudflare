/*
 * The dashboard's one stylesheet: Beautiful UI's design tokens, theme and keyframes (MIT, see
 * NOTICE), with shadcn/ui's variables mapped onto them, so `src/components/ui/*` (and whatever
 * `shadcn add` puts there) and the Beautiful UI primitives of `src/components/bui/` look alike.
 *
 * Light by default; `.dark` on <html> (public/theme.js sets it before the first paint, `lib/theme.ts`
 * after) switches every token.
 *
 * One rename: Beautiful UI's blue `--accent` is `--accent-blue` here (`bg-accent-blue`), because
 * shadcn's `--accent` is the grey of a hovered row (`hover:bg-accent`). `--accent-ink` and
 * `--accent-tint` keep their names.
 */

@import "tailwindcss";
/* shadow-plugin: smooth layered stacks on Tailwind's --shadow-xs...2xl, which the tokens build on. */
@import "shadow-plugin/unprefixed";
@import "tw-animate-css";
@import "shadcn/tailwind.css";
@import "@fontsource-variable/inter";
@import "@fontsource-variable/jetbrains-mono";

@custom-variant dark (&:where(.dark, .dark *));

/* -- Beautiful UI's tokens ------------------------------------------------ */

:root {
  /* surfaces: cool, blue-tinted neutrals */
  --page: oklch(0.985 0.001 286.376);
  --canvas: oklch(0.961 0.002 247.84);
  --surface: oklch(1 0 0);
  --inset: oklch(0.979 0.002 247.839);
  --hover: oklch(0.97 0.002 247.839);
  --hover-2: oklch(0.933 0.003 247.86);

  /* ink ramp */
  --ink: oklch(0.247 0.006 258.361);
  --ink-2: oklch(0.506 0.01 264.477);
  --ink-3: oklch(0.695 0.009 264.505);

  /* borders: solid and crisp, not alpha */
  --line: oklch(0.946 0.003 264.542);
  --line-strong: oklch(0.912 0.005 258.326);
  --line-soft: oklch(0.966 0.002 264.542);
  --grid-line: color-mix(in srgb, var(--line) 78%, transparent);
  --field: oklch(0.961 0.001 286.375);

  /* accent (Beautiful UI's --accent) */
  --accent-blue: oklch(0.626 0.205 254.947);
  --accent-ink: oklch(0.556 0.187 255.617);
  --accent-tint: oklch(0.96 0.019 252.878);

  /* semantic */
  --green: oklch(0.603 0.155 150.883);
  --green-tint: oklch(0.958 0.017 159.118);
  --orange: oklch(0.689 0.179 49.902);
  --orange-tint: oklch(0.964 0.021 67.581);
  --red: oklch(0.621 0.192 23.042);
  --red-tint: oklch(0.956 0.017 17.462);

  --tooltip-bg: oklch(0.272 0.008 264.435);
  --tooltip-fg: oklch(0.976 0.002 247.839);
  --tooltip-muted: oklch(0.731 0.008 260.731);
  --tooltip-border: oklch(0.356 0.007 264.474);

  /* shadows: a solid hairline ring + shadow-plugin's smooth stacks */
  --shadow-hairline: 0 0 0 1px var(--line);
  --shadow-btn: 0 0 0 1px var(--line-strong), var(--shadow-xs);
  --shadow-card: 0 0 0 1px var(--line), var(--shadow-sm);
  --shadow-raised: 0 0 0 1px var(--line), var(--shadow-md);
  --shadow-overlay: 0 0 0 1px var(--line), var(--shadow-lg);
  --shadow-inset-field: inset 0 1px 2px oklch(0 0 0 / 0.12);

  color-scheme: light;
}

.dark {
  --page: oklch(0.209 0.004 264.477);
  --canvas: oklch(0.231 0.004 264.487);
  --surface: oklch(0.26 0.006 271.191);
  --inset: oklch(0.243 0.004 264.492);
  --hover: oklch(0.289 0.006 271.22);
  --hover-2: oklch(0.318 0.007 274.747);

  --ink: oklch(0.964 0.002 247.839);
  --ink-2: oklch(0.731 0.008 260.731);
  --ink-3: oklch(0.541 0.01 264.484);

  --line: oklch(0.308 0.006 258.354);
  --line-strong: oklch(0.356 0.007 264.474);
  --line-soft: oklch(0.278 0.006 258.354);
  --field: oklch(0.293 0.006 271.223);

  --accent-blue: oklch(0.68 0.173 253.301);
  --accent-ink: oklch(0.788 0.113 248.33);
  --accent-tint: oklch(0.68 0.173 253.301 / 0.16);

  --green: oklch(0.705 0.154 153.814);
  --green-tint: oklch(0.705 0.154 153.814 / 0.14);
  --orange: oklch(0.746 0.156 55.642);
  --orange-tint: oklch(0.746 0.156 55.642 / 0.14);
  --red: oklch(0.666 0.18 21.433);
  --red-tint: oklch(0.666 0.18 21.433 / 0.14);

  --tooltip-bg: oklch(0.182 0.004 264.459);
  --tooltip-fg: oklch(0.964 0.002 247.839);
  --tooltip-muted: oklch(0.731 0.008 260.731);
  --tooltip-border: oklch(0.308 0.006 258.354);

  --shadow-hairline: 0 0 0 1px var(--line);
  /* elevation rings become a faint light hairline in dark mode */
  --shadow-btn: 0 0 0 1px oklch(1 0 0 / 0.1), 0 1px 2px oklch(0 0 0 / 0.3);
  --shadow-card: 0 0 0 1px oklch(1 0 0 / 0.11), 0 1px 2px oklch(0 0 0 / 0.2), 0 2px 6px oklch(0 0 0 / 0.2);
  --shadow-raised: 0 0 0 1px oklch(1 0 0 / 0.13), 0 2px 10px oklch(0 0 0 / 0.22);
  --shadow-overlay: 0 0 0 1px oklch(1 0 0 / 0.15), 0 8px 28px oklch(0 0 0 / 0.34);
  --shadow-inset-field: inset 0 1px 2px oklch(0 0 0 / 0.4);

  color-scheme: dark;
}

/* -- shadcn/ui's variables, on the tokens above (both themes follow) -------- */

:root {
  --background: var(--page);
  --foreground: var(--ink);
  --card: var(--surface);
  --card-foreground: var(--ink);
  --popover: var(--surface);
  --popover-foreground: var(--ink);
  --primary: var(--ink);
  --primary-foreground: var(--surface);
  --secondary: var(--hover-2);
  --secondary-foreground: var(--ink);
  --muted: var(--hover);
  --muted-foreground: var(--ink-2);
  --accent: var(--hover-2);
  --accent-foreground: var(--ink);
  --destructive: var(--red);
  --border: var(--line);
  --input: var(--line-strong);
  --ring: var(--ink-3);
  --chart-1: var(--accent-blue);
  --chart-2: var(--green);
  --chart-3: var(--orange);
  --chart-4: var(--red);
  --chart-5: var(--ink-3);
  --radius: 0.625rem;
  --sidebar: var(--canvas);
  --sidebar-foreground: var(--ink);
  --sidebar-primary: var(--ink);
  --sidebar-primary-foreground: var(--surface);
  --sidebar-accent: var(--hover-2);
  --sidebar-accent-foreground: var(--ink);
  --sidebar-border: var(--line);
  --sidebar-ring: var(--ink-3);
}

@theme inline {
  /* Beautiful UI */
  --color-page: var(--page);
  --color-canvas: var(--canvas);
  --color-surface: var(--surface);
  --color-inset: var(--inset);
  --color-ink: var(--ink);
  --color-ink-2: var(--ink-2);
  --color-ink-3: var(--ink-3);
  --color-hover: var(--hover);
  --color-hover-2: var(--hover-2);
  --color-field: var(--field);
  --color-line: var(--line);
  --color-line-strong: var(--line-strong);
  --color-accent-blue: var(--accent-blue);
  --color-accent-ink: var(--accent-ink);
  --color-accent-tint: var(--accent-tint);
  --color-green: var(--green);
  --color-green-tint: var(--green-tint);
  --color-orange: var(--orange);
  --color-orange-tint: var(--orange-tint);
  --color-red: var(--red);
  --color-red-tint: var(--red-tint);

  --shadow-hairline: var(--shadow-hairline);
  --shadow-btn: var(--shadow-btn);
  --shadow-inset-field: var(--shadow-inset-field);
  --shadow-card: var(--shadow-card);
  --shadow-raised: var(--shadow-raised);
  --shadow-overlay: var(--shadow-overlay);

  --font-sans: "Inter Variable", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "JetBrains Mono Variable", ui-monospace, "SF Mono", monospace;
  --font-heading: var(--font-sans);

  /* radii: chips 6, controls 8, cards 10, windows 14, pills 999 */
  --radius-chip: 6px;
  --radius-control: 8px;
  --radius-card: 10px;
  --radius-window: 14px;

  --ease-out-strong: cubic-bezier(0.23, 1, 0.32, 1);
  --ease-in-out-strong: cubic-bezier(0.77, 0, 0.175, 1);
  --ease-link: cubic-bezier(0.16, 1, 0.3, 1);

  /* shadcn/ui */
  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);
  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);
  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);
  --color-destructive: var(--destructive);
  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  --color-foreground: var(--foreground);
  --color-background: var(--background);
  --radius-sm: calc(var(--radius) * 0.6);
  --radius-md: calc(var(--radius) * 0.8);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) * 1.4);
  --radius-2xl: calc(var(--radius) * 1.8);
  --radius-3xl: calc(var(--radius) * 2.2);
  --radius-4xl: calc(var(--radius) * 2.6);
}

/* -- base ------------------------------------------------------------------ */

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
}

html {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  font-family: var(--font-sans);
}

body {
  background-color: var(--canvas);
  color: var(--ink);
  font-feature-settings: "cv11", "ss01";
  font-size: 14px;
  letter-spacing: -0.01em;
  line-height: 1.5;
}

::selection {
  background: var(--accent-tint);
  color: var(--ink);
}

h1,
h2,
h3,
h4 {
  text-wrap: balance;
}

p {
  text-wrap: pretty;
}

a {
  text-underline-position: from-font;
  text-decoration-skip-ink: auto;
}

/* a theme switch swaps every token at once: no transitions while it does */
.theme-switching *,
.theme-switching *::before,
.theme-switching *::after {
  transition: none !important;
}

/* Tailwind v4 resets buttons to cursor:default: anything clickable invites the click */
button:not(:disabled),
[role="button"]:not([aria-disabled="true"]),
label:has(input),
a {
  cursor: pointer;
}

:focus-visible {
  outline: 2px solid var(--accent-blue);
  outline-offset: 2px;
  border-radius: 4px;
}

input:focus-visible,
textarea:focus-visible,
select:focus-visible,
[contenteditable]:focus-visible {
  outline: none;
}

.animated-underline {
  position: relative;
  display: inline-block;
}

.animated-underline::after {
  position: absolute;
  right: 0;
  bottom: -1px;
  left: 0;
  height: 1px;
  content: "";
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 280ms var(--ease-link);
}

a:hover .animated-underline::after,
a:focus-visible .animated-underline::after {
  transform: scaleX(1);
}

/* -- keyframes ------------------------------------------------------------- */

@keyframes shimmer-text {
  from {
    background-position: 150% center;
  }
  to {
    background-position: -50% center;
  }
}

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes pop-in {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* the sign-in card and its parts: rise, sharpen, settle */
@keyframes sign-in-rise {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.985);
    filter: blur(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* pixel-grid loader: brighten plateau, staggered per cell */
@keyframes pixel-on {
  0%,
  100% {
    opacity: 0.15;
  }
  18%,
  42% {
    opacity: 1;
  }
  62% {
    opacity: 0.15;
  }
}

@keyframes caret-blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}

/* -- the home's entrance --------------------------------------------------- */

.home-reveal {
  will-change: opacity, transform, filter;
}

/* -- SidebarNav: one 224px tree clipped by a 52px shell when collapsed ----- */

.sidebar-row {
  width: 208px;
  transition-duration: var(--sidebar-copy-duration);
  transition-timing-function: var(--sidebar-easing);
}

.sidebar-copy {
  opacity: 1;
  transform: translateX(0);
  transition:
    opacity var(--sidebar-copy-duration) ease-out,
    transform var(--sidebar-copy-duration) var(--sidebar-easing);
}

.sidebar-logo,
.sidebar-collapse-control,
.sidebar-expand-control {
  transition-duration: var(--sidebar-copy-duration);
  transition-timing-function: ease-out;
}

.sidebar-expand-control {
  pointer-events: none;
  opacity: 0;
}

.sidebar-glide-highlight {
  right: 8px;
  left: 8px;
}

[data-sidebar-collapsed="true"] .sidebar-row {
  width: 36px;
}

[data-sidebar-collapsed="true"] .sidebar-copy {
  pointer-events: none;
  opacity: 0;
  transform: translateX(calc(var(--sidebar-copy-offset) * -1));
}

[data-sidebar-collapsed="true"] .sidebar-workspace-control {
  pointer-events: none;
}

/* the settings at the foot keep their icon, as round, when collapsed */
.sidebar-settings {
  transition-property: width, border-color, color, transform;
  transition-duration: var(--sidebar-copy-duration);
  transition-timing-function: var(--sidebar-easing);
}

[data-sidebar-collapsed="true"] .sidebar-settings {
  width: 36px;
}

[data-sidebar-collapsed="true"] .sidebar-logo,
[data-sidebar-collapsed="true"] .sidebar-collapse-control {
  pointer-events: none;
  opacity: 0;
}

[data-sidebar-collapsed="true"] .sidebar-expand-control {
  pointer-events: auto;
  opacity: 1;
}

.sidebar-chats {
  transition: opacity var(--sidebar-copy-duration) ease-out;
}

[data-sidebar-collapsed="true"] .sidebar-chats {
  pointer-events: none;
  opacity: 0;
}

[data-sidebar-collapsed="true"] .sidebar-glide-highlight {
  right: auto;
  width: 36px;
}

/* -- StreamText: the leading edge resolves out of a soft blur -------------- */

.stream-tail {
  filter: blur(1.6px);
  -webkit-mask-image: linear-gradient(to right, oklch(0 0 0) 20%, oklch(0 0 0 / 0.2));
  mask-image: linear-gradient(to right, oklch(0 0 0) 20%, oklch(0 0 0 / 0.2));
}

.stream-caret {
  display: inline-block;
  width: 2px;
  height: 1.05em;
  margin-left: 1.5px;
  translate: 0 -0.5px;
  border-radius: 1px;
  background: var(--ink);
  vertical-align: text-bottom;
  animation: caret-blink 1s step-end infinite;
}

.stream-caret.is-streaming {
  animation: none;
}

/* -- RecordsTable: one quiet surface, precise rules, colour kept for meaning --
 * The first column stays an anchor while both axes move inside the table's viewport. */

.records-shell {
  width: 100%;
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface);
  box-shadow: 0 1px 2px oklch(0 0 0 / 0.06);
}

.records-scroll {
  overflow: auto;
  overscroll-behavior: none;
  scrollbar-color: var(--line-strong) transparent;
}

.records-scroll:focus-visible {
  outline: 2px solid var(--accent-blue);
  outline-offset: -2px;
}

.records-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  color: var(--ink);
  font-size: 13px;
  font-weight: 500;
  table-layout: fixed;
}

.records-table th,
.records-table td {
  border-right: 1px solid var(--grid-line);
  border-bottom: 1px solid var(--grid-line);
  text-align: left;
  vertical-align: middle;
}

.records-table tr > :last-child {
  border-right: 0;
}

.records-table thead th {
  position: sticky;
  z-index: 5;
  top: 0;
  height: 35px;
  padding: 0;
  background: var(--surface);
  color: var(--ink-2);
  font-size: 12.5px;
  font-weight: 500;
}

.records-table thead th.records-sticky-cell {
  z-index: 7;
}

.records-header-button {
  display: flex;
  width: 100%;
  height: 35px;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  color: var(--ink-2);
  text-align: left;
  transition:
    background-color 120ms ease-out,
    color 120ms ease-out;
}

button.records-header-button:hover {
  background: var(--hover);
  color: var(--ink);
}

.records-header-icon {
  display: inline-flex;
  flex-shrink: 0;
  color: var(--ink-3);
}

.records-header-icon svg {
  width: 15px;
  height: 15px;
}

/* the arrow takes room only when it shows: a narrow column keeps its label */
.records-sort {
  display: none;
  flex-shrink: 0;
  margin-left: auto;
  transition: transform 160ms var(--ease-out-strong);
}

.records-header-button:hover .records-sort,
.records-sort.is-visible {
  display: inline-flex;
}

.records-cell {
  height: 35px;
  padding: 0 8px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.records-cell.is-end {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.records-sticky-cell {
  position: sticky;
  left: 0;
  z-index: 2;
  background: var(--surface);
  box-shadow: 5px 0 8px -10px oklch(0 0 0 / 0.4);
}

.records-first {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 4px;
}

.records-row > .records-cell {
  transition:
    background-color 120ms ease-out,
    color 120ms ease-out;
}

.records-row:hover > .records-cell {
  background: var(--hover);
}

.records-rownum {
  display: inline-flex;
  width: 24px;
  height: 24px;
  flex: 0 0 24px;
  align-items: center;
  justify-content: center;
  color: var(--ink-3);
  font-size: 11.5px;
  font-variant-numeric: tabular-nums;
}

.records-mark {
  display: inline-flex;
  width: 20px;
  height: 20px;
  flex: 0 0 20px;
  align-items: center;
  justify-content: center;
  margin-right: 4px;
  border-radius: 6px;
  color: var(--ink-2);
  background: var(--field);
  font-size: 10px;
  font-weight: 500;
}

.records-name {
  min-width: 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 13px;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.records-tags {
  position: relative;
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  gap: 4px;
  overflow: hidden;
}

.records-tags-measure {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  width: max-content;
  gap: 4px;
  pointer-events: none;
  visibility: hidden;
}

.records-tags-measure > span {
  display: inline-flex;
}

/* a tag's colours come from one mid-lightness hue, mixed with the theme's tokens */
.records-tag {
  --tag-base: var(--ink-3);
  display: inline-flex;
  height: 23px;
  max-width: 180px;
  align-items: center;
  flex-shrink: 0;
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--tag-base) 32%, var(--surface));
  border-radius: 8px;
  padding: 0 7px;
  color: color-mix(in srgb, var(--tag-base) 92%, var(--ink));
  background: color-mix(in srgb, var(--tag-base) 18%, var(--surface));
  font-size: 13px;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.records-more-tag {
  display: inline-flex;
  height: 23px;
  align-items: center;
  flex-shrink: 0;
  border: 1px solid var(--line-strong);
  border-radius: 6px;
  padding: 0 7px;
  color: var(--ink-3);
  background: var(--inset);
  font-size: 11px;
  font-weight: 500;
}

.records-muted {
  color: var(--ink-3);
}

.records-table tfoot td {
  position: sticky;
  z-index: 4;
  bottom: 0;
  height: 35px;
  background: var(--inset);
  color: var(--ink-2);
  font-size: 14px;
  font-weight: 500;
  line-height: 1;
}

.records-table tfoot .records-sticky-cell {
  z-index: 6;
}

.records-count {
  margin-right: 3px;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

/* touch: :hover sticks after a tap */
@media (hover: none) {
  .records-row:hover > .records-cell {
    background: transparent;
  }

  button.records-header-button:hover {
    background: transparent;
    color: var(--ink-2);
  }
}

/* -- FilterTable's electric status pills: the same hue-and-mix as a tag ----- */

.filter-status-green {
  --tag-base: oklch(0.652 0.131 162.865);
}
.filter-status-orange {
  --tag-base: oklch(0.757 0.153 66.401);
}
.filter-status-blue {
  --tag-base: oklch(0.671 0.118 219.351);
}
.filter-status-red {
  --tag-base: oklch(0.64 0.19 27);
}
.filter-status-neutral {
  --tag-base: var(--ink-3);
}

.filter-status {
  border: 1px solid color-mix(in srgb, var(--tag-base) 34%, var(--surface));
  color: color-mix(in srgb, var(--tag-base) 92%, var(--ink));
  background: color-mix(in srgb, var(--tag-base) 20%, var(--surface));
}

/* dark: a richer same-hue fill, bright same-hue text, no visible border */
.dark .records-tag,
.dark .filter-status {
  color: color-mix(in srgb, var(--tag-base) 86%, white);
  background: color-mix(in srgb, var(--tag-base) 34%, var(--surface));
  border-color: color-mix(in srgb, var(--tag-base) 34%, var(--surface));
}

/* -- scrollbars that do not show -------------------------------------------- */

.no-scrollbar {
  scrollbar-width: none;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}

@media (prefers-reduced-motion: reduce) {
  .home-reveal {
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
  }

  .stream-caret {
    animation: none;
  }

  .stream-tail {
    filter: none;
    -webkit-mask-image: none;
    mask-image: none;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* The sign-in's background, after the product's banner (assets/banner.svg): dots 34px apart, faint, fading
   out from the card; behind them the mark's warm light. Plain CSS: nothing to load, nothing the CSP refuses. */
.sign-in-dots {
  --sign-in-dot: rgb(0 0 0 / 0.06);
  background-image: radial-gradient(circle at center, var(--sign-in-dot) 2.5px, transparent 3px);
  background-size: 34px 34px;
  background-position: center;
  mask-image: radial-gradient(ellipse 70% 65% at 50% 45%, #000 0%, transparent 100%);
}

.sign-in-glow {
  background:
    radial-gradient(42% 38% at 46% 40%, rgb(255 224 122 / 0.32) 0%, transparent 70%),
    radial-gradient(60% 45% at 50% 42%, var(--page) 0%, transparent 70%);
}

.dark .sign-in-dots {
  --sign-in-dot: rgb(255 255 255 / 0.07);
}

.dark .sign-in-glow {
  background:
    radial-gradient(42% 38% at 46% 40%, rgb(255 200 31 / 0.10) 0%, transparent 70%),
    radial-gradient(60% 45% at 50% 42%, var(--page) 0%, transparent 70%);
}
