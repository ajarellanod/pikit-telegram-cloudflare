      "environment": [
        {
          "name": "TELEGRAM_BOT_TOKEN",
          "secret": true,
          "required": true,
          "description": "The bot's token from @BotFather; `pikit configure` asks for it and checks it."
        },
        {
          "name": "TELEGRAM_ALLOWED_USERS",
          "secret": false,
          "required": true,
          "description": "Telegram user ids allowed to talk to the bot, separated by commas; `pikit configure` fills it when you message the bot. Deployed without the CLI, it may stay empty: the owner claims the bot with TELEGRAM_CLAIM_CODE."
        },
        {
          "name": "TELEGRAM_WEBHOOK_SECRET",
          "secret": true,
          "required": true,
          "description": "What Telegram sends with every update, so only Telegram reaches your agent; `pikit configure` generates it, and `pikit up` gives it to Telegram."
        },
        {
          "name": "TELEGRAM_CLAIM_CODE",
          "secret": true,
          "required": false,
          "description": "Optional passphrase of 8 characters or more: a private chat that sends `/claim <passphrase>` may talk to the bot from then on. The Deploy to Cloudflare button's way to let its owner in; changing it revokes the claims made with the old one."
        }
      ],
      "hooks": {
        "afterDeploy": "src/pikit/channel-telegram-webhook/deploy.ts"
      }
    },
