      "environment": [
        {
          "name": "TELEGRAM_BOT_TOKEN",
          "secret": true,
          "required": true,
          "description": "The bot's token from @BotFather; `pikit configure` asks for it and checks it."
        },
        {
          "name": "TELEGRAM_ALLOWED_USERS",
          "secret": false,
          "required": true,
          "description": "Telegram user ids allowed to talk to the bot, separated by commas; `pikit configure` fills it when you message the bot. Deployed without the CLI, it may stay empty: the owner logs in with TELEGRAM_PASSWORD instead."
        },
        {
          "name": "TELEGRAM_WEBHOOK_SECRET",
          "secret": true,
          "required": true,
          "description": "What Telegram sends with every update, so only Telegram reaches your agent; `pikit configure` generates it, and `pikit up` gives it to Telegram."
        },
        {
          "name": "TELEGRAM_PASSWORD",
          "secret": true,
          "required": false,
          "description": "Optional password of 8 characters or more: send `/login <password>` to the bot, and that chat may talk to it from then on. Whoever knows it can log in; change it to log everyone out. The Deploy to Cloudflare button's way to let its owner in."
        }
      ],
      "hooks": {
        "afterDeploy": "src/pikit/channel-telegram-webhook/deploy.ts"
      }
    },
