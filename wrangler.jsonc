// The project on Cloudflare (deployment-cloudflare, SPEC §4.1): a Worker and one Durable Object per
// conversation, both running pikit.config.ts (its `worker` export and its default export).
//
// "name" is the Worker's (a Deploy to Cloudflare template's): Workers Builds deploys under it, and
// `pikit up`, `status`, `logs`, `down` and `dev` use it too, instead of package.json's "name".
//
// Secrets are never here: `pikit up` uploads .env's with the version (--secrets-file), and
// `pikit dev` (wrangler dev) reads .env.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Deploy to Cloudflare page may change it.
  "name": "pikit-telegram-bot",
  "main": "src/pikit/deployment-cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  // Components and Pi use node:* APIs that Workers provide with it (Buffer, crypto, process.env).
  "compatibility_flags": ["nodejs_compat"],
  // One object per conversation (C1). The entrypoint reads the binding as CONVERSATION.
  "durable_objects": {
    "bindings": [{ "name": "CONVERSATION", "class_name": "Conversation" }]
  },
  // SQLite-backed: storage-do, sessions and submissions keep the conversation in the object's SQL.
  // A migration is forever: add new ones below, never edit or remove this one.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conversation"] }],
  // The version /health reports: `pikit up` waits until it is the one it deployed (C8).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Logs kept by Cloudflare (Workers Logs, in the dashboard); `pikit logs` streams them live.
  "observability": { "enabled": true },
  // A prompt in a .md file is imported as text; a WebAssembly module is compiled at deploy (a Worker
  // cannot compile one at run time). A rule matches the import as written, so a module imported by a
  // package export without `.wasm` is named: execution-do's QuickJS.
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true },
    { "type": "CompiledWasm", "globs": ["**/*.wasm", "@jitl/quickjs-wasmfile-release-sync/wasm"], "fallthrough": true }
  ]
}
